# CARE Suriname — production settings template.
#
# Do NOT edit this file for a server. Run `bash make-env.sh <domain>` which
# copies it to .env and fills every <generated> value with a fresh random
# secret. .env is git-ignored and must never be committed or shared.

# --- Identity ---------------------------------------------------------------
CARE_DOMAIN=<domain>
APP_VERSION=local

# --- Django -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=<generated>
DJANGO_ALLOWED_HOSTS=["<domain>"]
CSRF_TRUSTED_ORIGINS=["https://<domain>"]
CORS_ALLOWED_ORIGINS=["https://<domain>"]
CURRENT_DOMAIN=https://<domain>
BACKEND_DOMAIN=https://<domain>
DJANGO_TIME_ZONE=America/Paramaribo
# Caddy terminates TLS and forwards X-Forwarded-Proto; Django trusts it.
DJANGO_SECURE_SSL_REDIRECT=false
USE_SMS=false
# RSA key set that signs login tokens. Regenerating it logs everyone out.
JWKS_BASE64=<generated>

# --- Database / queue -------------------------------------------------------
POSTGRES_USER=care
POSTGRES_PASSWORD=<generated>
POSTGRES_DB=care
# The start scripts wait on these before touching DATABASE_URL.
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://care:<POSTGRES_PASSWORD>@db:5432/care
REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0

# --- File storage (MinIO, S3-compatible) ------------------------------------
BUCKET_PROVIDER=aws
BUCKET_REGION=ap-south-1
BUCKET_KEY=care-minio
BUCKET_SECRET=<generated>
# Internal address the API uses; public address the browser is sent to.
BUCKET_ENDPOINT=http://minio:9000
BUCKET_EXTERNAL_ENDPOINT=https://files.<domain>
FILE_UPLOAD_BUCKET=patient-bucket
FACILITY_S3_BUCKET=facility-bucket

# --- Clinical workflow gates -----------------------------------------------
# Facilities allowed to finalise/amend forms, close consults, prescribe,
# discharge and compile letters. Without the right UUID here every one of
# those actions returns 503 and a clinician cannot save. The AZP UUID is
# stable across backup/restore; check with:
#   docker compose exec db psql -U care -d care -c \
#     "select external_id, name from facility_facility where deleted=false"
CLINICAL_WORKFLOW_MUTATIONS_ENABLED_FACILITIES=["77d446f3-659d-40d4-a69a-bfc0f5b7a255"]
# External correspondence delivery is out of pilot scope (decision D1).
CORRESPONDENCE_DELIVERY_ENABLED_FACILITIES=[]

# --- Optional ---------------------------------------------------------------
# Encrypted draft recovery. Unset = feature unavailable, same as the laptop.
# DRAFT_RECOVERY_WRAPPING_KEYS_FILE=
# Where nightly dumps land on the host (mounted at /backups in db).
BACKUP_DIR=./backups
