POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_DB=care
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@db:5432/care
REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0

DJANGO_DEBUG=true
ATTACH_DEBUGGER=false

# Irreversible clinical workflow mutations are enabled per facility, and the
# base default is an empty list. This container runs config.settings.deployment,
# so without this line every gated endpoint returns 503
# "workflow_mutations_disabled": finalising and amending clinical forms, closing
# a consultation, prescribing, discharging, and compiling letters. A clinician
# could write a note and never save it.
#
# The wildcard is appropriate for this single-machine development stack. A
# server deployment must list explicit facility UUIDs instead, which is what the
# flag exists for.
CLINICAL_WORKFLOW_MUTATIONS_ENABLED_FACILITIES=["*"]

# Deliberately left unset, which means empty. Pilot decision D1 puts external
# correspondence delivery out of scope, so the transport stays disabled rather
# than merely unused. See care_fe/docs/pilot-scope.md.
# CORRESPONDENCE_DELIVERY_ENABLED_FACILITIES=[]

BUCKET_REGION=ap-south-1
BUCKET_KEY=${MINIO_ACCESS_KEY:-minioadmin}
BUCKET_SECRET=${MINIO_SECRET_KEY:-minioadmin}
BUCKET_ENDPOINT=http://minio:9000
BUCKET_EXTERNAL_ENDPOINT=http://localhost:9100
FILE_UPLOAD_BUCKET=patient-bucket
FACILITY_S3_BUCKET=facility-bucket
