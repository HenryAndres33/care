# Environment for the isolated Playwright test stack (docker-compose.test.yaml).
#
# This stack shares nothing with the development stack. Hostnames below resolve
# inside the care-test compose network, so they intentionally repeat the same
# service names and internal ports as .local.env; isolation comes from the
# separate compose project, not from renaming services.
#
# Never point this file at the development database. The whole purpose of this
# stack is that resetting it can never destroy clinical data. See
# care_fe/docs/testing-environment.md.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_DB=care_test
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@db:5432/care_test

REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0

DJANGO_DEBUG=true
ATTACH_DEBUGGER=false

BUCKET_REGION=ap-south-1
BUCKET_KEY=${MINIO_ACCESS_KEY:-minioadmin}
BUCKET_SECRET=${MINIO_SECRET_KEY:-minioadmin}
BUCKET_ENDPOINT=http://minio:9000
BUCKET_EXTERNAL_ENDPOINT=http://localhost:9101
FILE_UPLOAD_BUCKET=patient-bucket
FACILITY_S3_BUCKET=facility-bucket
